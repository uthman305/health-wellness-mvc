@model WellnessCardSessionViewModel
@{ ViewData["Title"] = "Record Session"; }

<h2>Record a Wellness Card Session</h2>

<form asp-action="CreateSession" method="post" class="col-md-6">
    <input type="hidden" asp-for="MentorshipAssignmentId" />
    <div class="mb-3">
        <label asp-for="WellnessDimension" class="form-label">Wellness Dimension</label>
        <select asp-for="WellnessDimension" class="form-select">
            <option>Stress</option>
            <option>Fatigue</option>
            <option>Physical Activity</option>
            <option>Mental Health</option>
            <option>BMI</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save Session</button>
</form>
