@model WellnessCardSessionViewModel
@{ ViewData["Title"] = "Record Session"; }

<h1 class="text-2xl font-semibold tracking-tight text-on-surface mb-1">Record a Session</h1>
<p class="text-sm text-on-surface-variant mb-6">Wellness card entry for this mentorship pairing.</p>

<form asp-action="CreateSession" method="post" class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 flex flex-col gap-4">
    <input type="hidden" asp-for="MentorshipAssignmentId" />

    <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-on-surface">Wellness Dimension</label>
        <select asp-for="WellnessDimension" class="w-full h-12 px-3.5 bg-surface-container-low border border-outline-variant rounded-xl text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
            <option>Stress</option>
            <option>Fatigue</option>
            <option>Physical Activity</option>
            <option>Mental Health</option>
            <option>BMI</option>
        </select>
    </div>

    <div class="flex flex-col gap-1.5">
        <label asp-for="Notes" class="text-xs font-medium text-on-surface">Notes</label>
        <textarea asp-for="Notes" rows="4" class="w-full px-3.5 py-3 bg-surface-container-low border border-outline-variant rounded-xl text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"></textarea>
    </div>

    <button type="submit" class="w-full h-12 mt-2 bg-primary text-on-primary text-sm font-semibold rounded-xl hover:opacity-90 transition">
        Save Session
    </button>
</form>
