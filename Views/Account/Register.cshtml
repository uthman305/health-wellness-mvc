@model RegisterViewModel
@{ ViewData["Title"] = "Register"; Layout = "_Layout"; }

<div class="w-full max-w-[420px] mx-auto py-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center text-white shrink-0">
            <span class="material-symbols-outlined text-[20px]">favorite</span>
        </div>
        <div>
            <h1 class="font-semibold text-on-surface leading-tight">FPI Wellness</h1>
            <p class="text-xs text-on-surface-variant">Join the campus wellness community</p>
        </div>
    </div>

    <div asp-validation-summary="All" class="text-error text-sm mb-4"></div>

    <form asp-action="Register" method="post" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-on-surface">Select your profile role</label>
            <select asp-for="Role" class="w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm">
                <option value="Student">Student</option>
                <option value="Lecturer">Staff / Faculty</option>
            </select>
        </div>

        <div class="flex flex-col gap-1.5">
            <label asp-for="FullName" class="text-xs font-medium text-on-surface">Full Name</label>
            <div class="relative">
                <span class="material-symbols-outlined text-[20px] text-outline absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">person</span>
                <input asp-for="FullName" placeholder="e.g. Uthman Salman" class="w-full h-12 pl-10 pr-3.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition shadow-sm" />
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <label asp-for="Email" class="text-xs font-medium text-on-surface">Academic / Campus Email</label>
            <div class="relative">
                <span class="material-symbols-outlined text-[20px] text-outline absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">alternate_email</span>
                <input asp-for="Email" placeholder="e.g. u.salman@federalpolyilaro.edu.ng" class="w-full h-12 pl-10 pr-3.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition shadow-sm" />
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <label asp-for="Password" class="text-xs font-medium text-on-surface">Create Password</label>
            <div class="relative">
                <span class="material-symbols-outlined text-[20px] text-outline absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">lock</span>
                <input asp-for="Password" placeholder="At least 8 characters" class="w-full h-12 pl-10 pr-3.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition shadow-sm" />
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <label asp-for="ConfirmPassword" class="text-xs font-medium text-on-surface">Confirm Password</label>
            <div class="relative">
                <span class="material-symbols-outlined text-[20px] text-outline absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">lock_reset</span>
                <input asp-for="ConfirmPassword" placeholder="Re-enter your password" class="w-full h-12 pl-10 pr-3.5 bg-surface-container-lowest border border-outline-variant rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition shadow-sm" />
            </div>
        </div>

        <button type="submit" class="w-full h-12 mt-2 bg-primary text-on-primary text-sm font-semibold rounded-xl hover:opacity-90 transition shadow-sm flex items-center justify-center gap-2 active:scale-[0.99]">
            <span>Create account</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
    </form>

    <div class="text-center mt-6">
        <p class="text-sm text-on-surface-variant">
            Already have an account?
            <a asp-action="Login" class="text-primary font-semibold hover:underline underline-offset-2 ml-1">Sign in</a>
        </p>
    </div>
</div>
