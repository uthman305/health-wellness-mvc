@model WellnessLogViewModel
@{ ViewData["Title"] = "Log Wellness"; }

<h2>Log Your Wellness</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Log" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="StressScore" class="form-label">Stress (1–10)</label>
        <input asp-for="StressScore" class="form-control" type="number" min="1" max="10" />
    </div>
    <div class="mb-3">
        <label asp-for="FatigueScore" class="form-label">Fatigue (1–10)</label>
        <input asp-for="FatigueScore" class="form-control" type="number" min="1" max="10" />
    </div>
    <div class="mb-3">
        <label asp-for="ActivityMins" class="form-label">Physical Activity (minutes today)</label>
        <input asp-for="ActivityMins" class="form-control" type="number" min="0" />
    </div>
    <div class="mb-3">
        <label asp-for="MentalScore" class="form-label">Mental Health (1–10)</label>
        <input asp-for="MentalScore" class="form-control" type="number" min="1" max="10" />
    </div>
    <div class="mb-3">
        <label asp-for="HeightM" class="form-label">Height (metres)</label>
        <input asp-for="HeightM" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label asp-for="WeightKg" class="form-label">Weight (kg)</label>
        <input asp-for="WeightKg" class="form-control" type="number" step="0.1" />
    </div>
    <button type="submit" class="btn btn-primary">Submit Log</button>
</form>
