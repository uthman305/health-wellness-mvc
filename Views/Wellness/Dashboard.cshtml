@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<h1 class="text-2xl font-semibold tracking-tight text-on-surface mb-1">Good day, @Model.FullName.Split(' ')[0]</h1>
<p class="text-sm text-on-surface-variant mb-6">Here is your wellness summary.</p>

@if (TempData["BmiResult"] != null)
{
    <div class="bg-secondary-container/40 border border-secondary/30 text-on-secondary-container text-sm rounded-lg px-4 py-3 mb-4">
        Latest BMI: @TempData["BmiResult"]
    </div>
}
@if (TempData["NewBadges"] != null)
{
    <div class="bg-primary/10 border border-primary/20 text-primary text-sm rounded-lg px-4 py-3 mb-4">
        New badge(s) earned: @TempData["NewBadges"]
    </div>
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 mb-4 text-center">
    <p class="text-6xl font-bold text-primary">@Model.TotalPoints</p>
    <p class="text-sm text-on-surface-variant mt-1">Wellness Points</p>
</div>

<div class="grid grid-cols-2 gap-3 mb-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <span class="material-symbols-outlined text-primary text-[22px]">military_tech</span>
        <p class="text-2xl font-bold mt-1">@Model.Badges.Count</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide">Badges</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <span class="material-symbols-outlined text-tertiary text-[22px]">monitor_weight</span>
        <p class="text-2xl font-bold mt-1">@(Model.LatestBmi != null ? Model.LatestBmi.Bmi.ToString("0.0") : "—")</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide">@(Model.LatestBmi?.Category ?? "No BMI yet")</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <span class="material-symbols-outlined text-secondary text-[22px]">fact_check</span>
        <p class="text-2xl font-bold mt-1">@Model.RecentLogs.Count</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide">Total Logs</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <span class="material-symbols-outlined text-primary text-[22px]">bolt</span>
        <p class="text-2xl font-bold mt-1">@(Model.RecentLogs.Count > 0 ? "Active" : "—")</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide">Status</p>
    </div>
</div>

@if (Model.Badges.Any())
{
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 mb-4">
        <h3 class="text-sm font-semibold text-on-surface mb-2">Your badges</h3>
        <div class="flex flex-wrap gap-2">
            @foreach (var badge in Model.Badges)
            {
                <span class="text-xs font-medium bg-secondary-container text-on-secondary-container px-3 py-1 rounded-full">@badge</span>
            }
        </div>
    </div>
}

@{
    var riskColor = Model.RiskLevel switch
    {
        "High" => "bg-error-container/40 border-error/30 text-on-error-container",
        "Moderate" => "bg-amber-100 border-amber-300 text-amber-800",
        _ => "bg-secondary-container/40 border-secondary/30 text-on-secondary-container"
    };
    var riskIcon = Model.RiskLevel switch
    {
        "High" => "warning",
        "Moderate" => "info",
        _ => "check_circle"
    };
}
<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 mb-4">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-on-surface">Predictive Health Risk</h3>
        <span class="text-xs px-3 py-1 rounded-full border font-semibold @riskColor flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">@riskIcon</span>
            @Model.RiskLevel Risk
        </span>
    </div>
    <ul class="flex flex-col gap-1.5">
        @foreach (var factor in Model.RiskFactors)
        {
            <li class="text-xs text-on-surface-variant flex items-start gap-1.5">
                <span class="material-symbols-outlined text-[14px] mt-0.5">chevron_right</span>
                @factor
            </li>
        }
    </ul>
    <p class="text-[11px] text-on-surface-variant/70 mt-3 italic">Based on trends in your last several check-ins — not a medical diagnosis.</p>
</div>

<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 mb-4">
    <h3 class="text-sm font-semibold text-on-surface mb-3">Recent Trends</h3>
    @if (Model.RecentLogs.Count < 2)
    {
        <div class="bg-surface-container-low text-on-surface-variant text-sm rounded-lg px-4 py-6 text-center">
            Log your wellness at least twice to see your trend chart.
        </div>
    }
    else
    {
        <canvas id="trendChart" height="180"></canvas>
    }
</div>

<a asp-action="Log" class="block w-full h-12 bg-primary text-on-primary text-sm font-semibold rounded-xl flex items-center justify-center gap-2 hover:opacity-90 transition">
    <span class="material-symbols-outlined text-[18px]">add_circle</span>
    Log Wellness Now
</a>

@section Scripts {
    @if (Model.RecentLogs.Count >= 2)
    {
        <script>
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentLogs.Select(l => l.CreatedAt.ToString("MMM d"))));
            const stress = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentLogs.Select(l => l.StressScore)));
            const fatigue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentLogs.Select(l => l.FatigueScore)));
            const mental = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentLogs.Select(l => l.MentalScore)));

            new Chart(document.getElementById('trendChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Stress', data: stress, borderColor: '#ba1a1a', tension: 0.4 },
                        { label: 'Fatigue', data: fatigue, borderColor: '#f9a825', tension: 0.4 },
                        { label: 'Mental Health', data: mental, borderColor: '#006e2c', tension: 0.4 }
                    ]
                },
                options: { scales: { y: { min: 0, max: 10 } }, plugins: { legend: { labels: { font: { family: 'Inter', size: 11 } } } } }
            });
        </script>
    }
}
