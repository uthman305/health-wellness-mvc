@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }

<h1 class="text-2xl font-semibold tracking-tight text-on-surface mb-1">Institution Overview</h1>
<p class="text-sm text-on-surface-variant mb-6">Aggregate, anonymised data only — no individual records shown.</p>

<div class="grid grid-cols-2 gap-3 mb-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.TotalUsers</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Total Users</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.DailyActiveUsers</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Active Today</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.TotalStudents</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Students</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.TotalLecturers</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Lecturers</p>
    </div>
</div>

<div class="grid grid-cols-3 gap-3 mb-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-xl font-bold text-error">@Model.AverageStress.ToString("0.0")</p>
        <p class="text-xs text-on-surface-variant mt-1">Avg. Stress</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-xl font-bold text-on-surface">@Model.AverageFatigue.ToString("0.0")</p>
        <p class="text-xs text-on-surface-variant mt-1">Avg. Fatigue</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-xl font-bold text-secondary">@Model.AverageMentalScore.ToString("0.0")</p>
        <p class="text-xs text-on-surface-variant mt-1">Avg. Mental</p>
    </div>
</div>

<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5 mb-4">
    <h3 class="text-sm font-semibold text-on-surface mb-3">BMI Distribution</h3>
    <canvas id="bmiChart" height="140"></canvas>
</div>

<div class="flex items-center gap-2 mt-8 mb-1">
    <span class="material-symbols-outlined text-primary text-[20px]">monitor_heart</span>
    <h2 class="text-lg font-semibold tracking-tight text-on-surface">Predictive Analytics &amp; Health Risk</h2>
</div>
<p class="text-xs text-on-surface-variant mb-4">
    Rule-based trend scoring across all users' recent check-ins — flags rising stress/fatigue and declining mental health before they show up as a crisis. Aggregate only; no individual is identified.
</p>

<div class="grid grid-cols-3 gap-3 mb-4">
    <div class="bg-secondary-container/30 border border-secondary/30 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-secondary-container">@Model.LowRiskCount</p>
        <p class="text-xs text-on-secondary-container/80 uppercase tracking-wide mt-1">Low Risk</p>
    </div>
    <div class="bg-amber-100 border border-amber-300 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-amber-800">@Model.ModerateRiskCount</p>
        <p class="text-xs text-amber-800/80 uppercase tracking-wide mt-1">Moderate Risk</p>
    </div>
    <div class="bg-error-container/40 border border-error/30 rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-error-container">@Model.HighRiskCount</p>
        <p class="text-xs text-on-error-container/80 uppercase tracking-wide mt-1">High Risk</p>
    </div>
</div>

<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5">
    <h3 class="text-sm font-semibold text-on-surface mb-3">Population Stress Trend (last 14 days)</h3>
    @if (Model.TrendValues.Count < 2)
    {
        <div class="bg-surface-container-low text-on-surface-variant text-sm rounded-lg px-4 py-6 text-center">
            Not enough logged data yet to show a population trend.
        </div>
    }
    else
    {
        <canvas id="riskTrendChart" height="140"></canvas>
    }
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('bmiChart'), {
            type: 'bar',
            data: {
                labels: ['Underweight', 'Normal', 'Overweight', 'Obese'],
                datasets: [{
                    label: 'Users',
                    data: [@Model.UnderweightCount, @Model.NormalCount, @Model.OverweightCount, @Model.ObeseCount],
                    backgroundColor: ['#1a73e8', '#006e2c', '#f9a825', '#ba1a1a'],
                    borderRadius: 6
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        @if (Model.TrendValues.Count >= 2)
        {
            <text>
            new Chart(document.getElementById('riskTrendChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels)),
                    datasets: [{
                        label: 'Avg. Stress (population)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendValues)),
                        borderColor: '#ba1a1a',
                        backgroundColor: 'rgba(186,26,26,0.08)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: { scales: { y: { min: 0, max: 10 } } }
            });
            </text>
        }
    </script>
}
