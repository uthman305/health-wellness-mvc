@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }

<h1 class="text-2xl font-semibold tracking-tight text-on-surface mb-1">Institution Overview</h1>
<p class="text-sm text-on-surface-variant mb-6">Aggregate, anonymised data only — no individual records shown.</p>

<div class="grid grid-cols-2 gap-3 mb-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.TotalUsers</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Total Users</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.DailyActiveUsers</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Active Today</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.TotalStudents</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Students</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-2xl font-bold text-on-surface">@Model.TotalLecturers</p>
        <p class="text-xs text-on-surface-variant uppercase tracking-wide mt-1">Lecturers</p>
    </div>
</div>

<div class="grid grid-cols-3 gap-3 mb-4">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-xl font-bold text-error">@Model.AverageStress.ToString("0.0")</p>
        <p class="text-xs text-on-surface-variant mt-1">Avg. Stress</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-xl font-bold text-on-surface">@Model.AverageFatigue.ToString("0.0")</p>
        <p class="text-xs text-on-surface-variant mt-1">Avg. Fatigue</p>
    </div>
    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-4 text-center">
        <p class="text-xl font-bold text-secondary">@Model.AverageMentalScore.ToString("0.0")</p>
        <p class="text-xs text-on-surface-variant mt-1">Avg. Mental</p>
    </div>
</div>

<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-5">
    <h3 class="text-sm font-semibold text-on-surface mb-3">BMI Distribution</h3>
    <canvas id="bmiChart" height="140"></canvas>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('bmiChart'), {
            type: 'bar',
            data: {
                labels: ['Underweight', 'Normal', 'Overweight', 'Obese'],
                datasets: [{
                    label: 'Users',
                    data: [@Model.UnderweightCount, @Model.NormalCount, @Model.OverweightCount, @Model.ObeseCount],
                    backgroundColor: ['#1a73e8', '#006e2c', '#f9a825', '#ba1a1a'],
                    borderRadius: 6
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
